---
import { site } from '../site';

const path = Astro.url.pathname;
const links = [
  { href: '/#about', label: 'About' },
  { href: '/publications/', label: 'Publications', short: 'Papers' },
  { href: '/news/', label: 'News' },
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label={`${site.name}, home`}>
    <span class="brand-mark" aria-hidden="true"></span>
    <span class="brand-name">{site.shortName}</span>
  </a>
  <nav aria-label="Main">
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
              {link.short ? (
                <>
                  <span class="label-long">{link.label}</span>
                  <span class="label-short">{link.short}</span>
                </>
              ) : (
                link.label
              )}
            </a>
          </li>
        ))
      }
      <li><a href={site.cv} target="_blank" rel="noopener">CV<span aria-hidden="true">↗</span></a></li>
      <li>
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle cx="12" cy="12" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
            <path d="M12 3.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor"></path>
          </svg>
        </button>
      </li>
    </ul>
  </nav>
</header>

<script>
  const root = document.documentElement;
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    localStorage.setItem('theme', next);
    root.dataset.theme = next;
  });

  const header = document.querySelector('.site-header');
  const onScroll = () => header?.classList.toggle('is-scrolled', scrollY > 24);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
