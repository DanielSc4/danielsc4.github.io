---
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import { publications, groupByYear } from '../lib/publications';
import { site } from '../site';

const groups = groupByYear(publications);
---

<Base
  title="Publications"
  description={`Publications by ${site.name} on interpretability, activation steering and reasoning in large language models.`}
>
  <section class="page-head container">
    <h1>Publications</h1>
    <p class="lede">{publications.length} papers, newest first.</p>
    <a class="button ghost scholar-link" href={site.socials.find((s) => s.label === 'Scholar')!.url} target="_blank" rel="noopener">
      <span class="logo" style="--logo: url(/logos/scholar.svg)" aria-hidden="true"></span>
      Google Scholar <span aria-hidden="true">↗</span>
    </a>
  </section>

  <div class="container">
    {
      groups.map(([year, pubs]) => (
        <section class="year-group" aria-labelledby={`y${year}`}>
          <h2 id={`y${year}`} class="year mono">{year}</h2>
          <div class="pub-list">
            {pubs.map((pub) => (
              <PubItem pub={pub} />
            ))}
          </div>
        </section>
      ))
    }
    <p class="pub-note">* Equal contribution</p>
  </div>
</Base>
