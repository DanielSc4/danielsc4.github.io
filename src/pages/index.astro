---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import NewsList from '../components/NewsList.astro';
import { Content as Academic } from '../data/about/academic.md';
import { Content as Casual } from '../data/about/casual.md';
import { Content as Oversteered } from '../data/about/oversteered.md';
import { selectedPublications, publications } from '../lib/publications';
import { site } from '../site';
import portrait from '../assets/prof_pic.jpg';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: 'PhD Researcher',
  description: site.description,
  affiliation: site.affiliations.map((a) => ({ '@type': 'CollegeOrUniversity', name: a.name, url: a.url })),
  knowsAbout: ['Interpretability', 'Large Language Models', 'Activation Steering', 'Reasoning Models', 'Natural Language Processing'],
  sameAs: site.socials.map((s) => s.url),
};
---

<Base terrain="full" jsonLd={jsonLd}>
  <section class="hero container">
    <div class="hero-copy">
      <h1 class="hero-title">Daniel<br />Scalena</h1>
      <p class="lede">
        I <button type="button" class="egg" data-egg="inspect">look inside</button> language models to understand how they
        think, and use what I find to make them more reliable, controllable and capable.
      </p>
      <dl class="status">
        {
          site.status.map((item) => (
            <div class="status-row">
              <span class="status-logos" aria-hidden="true">
                {item.logos.map((logo) => (
                  <span class="logo" style={`--logo: url(/logos/${logo}.svg)`} />
                ))}
              </span>
              <dt class="status-label mono">{item.label}</dt>
              <dd class="status-text">
                {item.title}
                <span class="status-org">{item.org}</span>
              </dd>
            </div>
          ))
        }
        <div class="status-row">
          <span class="status-logos" aria-hidden="true" />
          <dt class="status-label mono">Base</dt>
          <dd class="status-text">{site.location}</dd>
        </div>
      </dl>
      <div class="hero-links">
        <a class="button" href={site.cv} target="_blank" rel="noopener">CV <span aria-hidden="true">↗</span></a>
        <a class="button ghost" href="#contact">Get in touch</a>
      </div>
    </div>
    <div class="hero-foot">
      <span class="scroll-cue mono" aria-hidden="true">Scroll to explore</span>
    </div>
  </section>

  <section id="about" class="section container">
    <header class="section-head">
      <h2>About</h2>
      <label class="steer mono" title="Steering strength">
        <span aria-hidden="true">α</span>
        <span class="sr-only">Steering strength for the bio</span>
        <input type="range" min="0" max="2" step="1" value="0" data-steer />
        <output data-steer-value>0</output>
      </label>
    </header>
    <div class="about">
      <div class="prose" data-steer-target>
        <Academic />
      </div>
      <figure class="portrait">
        <Picture
          src={portrait}
          formats={['avif', 'webp']}
          width={640}
          widths={[320, 640]}
          sizes="(min-width: 900px) 320px, 60vw"
          alt="Portrait of Daniel Scalena"
          loading="lazy"
        />
      </figure>
    </div>
    <template data-steer-level="0"><Academic /></template>
    <template data-steer-level="1"><Casual /></template>
    <template data-steer-level="2"><Oversteered /></template>
  </section>

  <section id="work" class="section container">
    <header class="section-head">
      <h2>Selected work</h2>
      <a class="section-link mono" href="/publications/">All {publications.length} publications →</a>
    </header>
    <div class="pub-list">
      {selectedPublications.map((pub) => <PubItem pub={pub} showPreview />)}
    </div>
  </section>

  <section id="news" class="section container">
    <header class="section-head">
      <h2>News</h2>
      <a class="section-link mono" href="/news/">All news →</a>
    </header>
    <NewsList limit={4} />
  </section>
</Base>
