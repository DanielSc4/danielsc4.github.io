---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import NewsList from '../components/NewsList.astro';
import { Content as About } from '../data/about.md';
import { selectedPublications, publications } from '../lib/publications';
import { site } from '../site';
import portrait from '../assets/prof_pic.jpg';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: 'PhD Researcher',
  description: site.description,
  affiliation: site.affiliations.map((a) => ({ '@type': 'CollegeOrUniversity', name: a.name, url: a.url })),
  knowsAbout: ['Interpretability', 'Large Language Models', 'Activation Steering', 'Reasoning Models', 'Natural Language Processing'],
  sameAs: site.socials.map((s) => s.url),
};
---

<Base terrain="full" jsonLd={jsonLd}>
  <section class="hero container">
    <div class="hero-copy">
      <h1 class="hero-title">Daniel<br />Scalena</h1>
      <p class="lede">{site.tagline}</p>
      <div class="hero-links">
        <a class="button" href={site.cv} target="_blank" rel="noopener">CV <span aria-hidden="true">↗</span></a>
        <a class="button ghost" href="#contact">Get in touch</a>
      </div>
    </div>
    <div class="hero-foot mono" aria-hidden="true">
      <span class="scroll-cue">Scroll to explore</span>
    </div>
  </section>

  <section id="about" class="section container">
    <header class="section-head">
      <h2>About</h2>
    </header>
    <div class="about">
      <div class="prose">
        <About />
      </div>
      <figure class="portrait">
        <Picture
          src={portrait}
          formats={['avif', 'webp']}
          width={640}
          widths={[320, 640]}
          sizes="(min-width: 900px) 320px, 60vw"
          alt="Portrait of Daniel Scalena"
          loading="lazy"
        />
      </figure>
    </div>
    <dl class="facts">
      <div>
        <dt class="mono">Based in</dt>
        <dd>{site.location}</dd>
      </div>
      <div>
        <dt class="mono">Focus</dt>
        <dd>Interpretability, steering, reasoning and agents</dd>
      </div>
      <div>
        <dt class="mono">Reviewer</dt>
        <dd>NeurIPS, ICML, EMNLP, ACL</dd>
      </div>
    </dl>
  </section>

  <section id="path" class="section container">
    <header class="section-head">
      <h2>Experience &amp; education</h2>
      <a class="section-link mono" href={site.cv} target="_blank" rel="noopener">Full CV ↗</a>
    </header>
    <ol class="path">
      {
        site.path.map((item) => (
          <li class="path-item">
            <div class="path-logos" aria-hidden="true">
              {item.logos.map((logo) => (
                <span class="logo" style={`--logo: url(/logos/${logo}.svg)`} />
              ))}
            </div>
            <div class="path-body">
              <h3>{item.role}</h3>
              <p class="path-org">{item.org}</p>
              <p class="path-detail">{item.detail}</p>
            </div>
            <p class="path-dates mono">{item.dates}</p>
          </li>
        ))
      }
    </ol>
    <a class="button ghost path-cv" href={site.cv} target="_blank" rel="noopener">Download the full CV <span aria-hidden="true">↗</span></a>
  </section>

  <section id="work" class="section container">
    <header class="section-head">
      <h2>Selected work</h2>
      <a class="section-link mono" href="/publications/">All {publications.length} publications →</a>
    </header>
    <div class="pub-list">
      {selectedPublications.map((pub) => <PubItem pub={pub} showPreview />)}
    </div>
  </section>

  <section id="news" class="section container">
    <header class="section-head">
      <h2>News</h2>
      <a class="section-link mono" href="/news/">All news →</a>
    </header>
    <NewsList limit={4} />
  </section>
</Base>
