---
import Base from '../layouts/Base.astro';
import NewsList from '../components/NewsList.astro';
import { site } from '../site';
---

<Base title="News" description={`Latest updates from ${site.name}: papers, talks and positions.`}>
  <section class="page-head container">
    <p class="kicker mono">Log</p>
    <h1>News</h1>
  </section>
  <div class="container">
    <NewsList />
  </div>
</Base>
